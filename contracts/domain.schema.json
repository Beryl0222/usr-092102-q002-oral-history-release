{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "抗联录音开放编目领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CARRIER_ACCESSIONED",
        "DIGITIZATION_VERIFIED",
        "SPEAKER_ANNOTATED",
        "RELEASE_APPROVED",
        "SEGMENT_WITHDRAWN"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "physical_carrier",
        "audio_segment",
        "transcript_revision",
        "release_decision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
